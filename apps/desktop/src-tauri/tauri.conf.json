{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sticial Studio",
  "version": "0.1.0",
  "identifier": "com.sticialstudio.ide",
  "build": {
    "frontendDist": "../../web/out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sticial Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "bin/arduino-cli.exe": "bin/arduino-cli.exe",
      "bin/LICENSE.txt": "bin/arduino-cli-LICENSE.txt",
      "arduino-staging/": "arduino-staging/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
